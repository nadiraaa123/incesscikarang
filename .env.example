# Mode online (Supabase). Kosongkan untuk mode demo (data contoh di browser).
# Di Vercel: Project Settings → Environment Variables. Anon key memang publik; keamanan ada di RLS (supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
